    "backup": "node scripts/backup.mjs",
    "test:dom": "node scripts/test/dom_smoke.mjs",
    "test:live": "node scripts/test/live.mjs",
    "test:table": "node scripts/test/table.mjs",
    "test:ui": "node scripts/test/ui_flows.mjs",
    "test:mobile": "node scripts/test/mobile.mjs",
    "test:board": "node scripts/test/board.mjs",
    "test:cross": "node scripts/test/cross.mjs",
    "test:dice": "node scripts/test/dice3d.mjs",
    "test:2dev": "node scripts/test/live_two_devices.mjs",
    "test:2dev:sdk": "TRANSPORT=sdk node scripts/test/live_two_devices.mjs",
    "test:2dev:rest": "TRANSPORT=rest node scripts/test/live_two_devices.mjs"
  },
  "devDependencies": {
    "jsdom": "^29.1.1",
    "playwright": "^1.62.1",
